@model PlaytestOps.Web.Pages.TestListViewModel
@using PlaytestOps.Web.Models

@{
    var queuedCount = Model.Tests.Sum(test => test.Runs.Count(run => run.State == "Queued"));
    var activeCount = Model.Tests.Sum(test => test.Runs.Count(run => run.State is "Pending" or "Running"));
}
@if (!Model.LoadFailed && (queuedCount + activeCount > 0 || Model.HasActiveWork))
{
    <div class="queue-summary" role="status" hx-get="@Url.Page("/Index", "Tests")" hx-trigger="every 3s"
         hx-target="#test-list" hx-swap="innerHTML" hx-sync="#test-list:drop" hx-disabled-elt="#test-list form button:not([disabled]), .refresh-button:not([disabled])" hx-request='{"timeout":15000}'>
        @if (queuedCount + activeCount > 0)
        {
            <strong>@queuedCount queued · @activeCount starting / running</strong>
            <span>Positions are per Unity project. #1 is next. Progress updates while work is active.</span>
        }
        else
        {
            <strong>Waiting for Unity Editor reconnection</strong>
            <span>Work is still queued or active. Tests are hidden until the Editor reconnects.</span>
        }
    </div>
}
@if (Model.Notice is not null) { <p role="status" class="run-notice">@Model.Notice</p> }
@if (Model.LoadFailed)
{
    <div class="empty-state load-error" role="alert">
        <h2>Tests couldn't be loaded.</h2>
        <p>The saved test data is temporarily unavailable. Try Refresh tests again.</p>
    </div>
}
else if (Model.ConnectedProjects is null || Model.ConnectedProjects.Count == 0)
{
    <div class="empty-state">
        <h2>No Unity Editor connected.</h2>
        <p><a asp-page="/Editors">Connect a Unity Editor</a>, then refresh to see that project's tests. Saved tests and run history are retained.</p>
    </div>
}
else if (Model.Tests.Count == 0)
{
    <div class="empty-state">
        <h2>No tests discovered.</h2>
        <p>The connected Editor hasn't synchronized any tests yet. Discover / refresh tests in Unity, then refresh this view.</p>
    </div>
}
else
{
    <div class="test-table-wrap">
        <table class="test-table">
            <caption class="visually-hidden">Playtests from connected Unity Editors with descriptions and current status</caption>
            <thead><tr><th scope="col">Status</th><th scope="col">Name</th><th scope="col">Description</th></tr></thead>
            <tbody>
            @foreach (var test in Model.Tests)
            {
                var (label, statusClass) = test.Status switch
                {
                    TestStatus.NotStarted => ("Not Started", "not-started"),
                    TestStatus.Running => ("Running", "running"),
                    TestStatus.Failed => ("Failed", "failed"),
                    TestStatus.Passed => ("Passed", "passed"),
                    _ => ("Unknown", "not-started")
                };
                var latest = test.Runs.OrderByDescending(x => x.RequestedAt).FirstOrDefault();
                var testBusy = latest?.State is "Queued" or "Pending" or "Running";
                var canRun = Model.CanRun && test.ProjectId is not null && Model.ConnectedProjects?.Contains(test.ProjectId) == true && test.IsAvailable && (test.RunState is "Runnable" or "Explicit") && !testBusy;
                if (latest?.State == "Pending") { label = "Starting"; statusClass = "running"; }
                if (latest?.State == "Queued") { label = $"Queued #{latest.QueuePosition}"; statusClass = "queued"; }
                <tr data-test-id="@test.Id">
                    <td><span class="test-status status-@statusClass">@label</span></td>
                    <th scope="row">@test.Name
                        <small class="d-block fw-normal">@(test.Project is null ? "Placeholder" : $"{test.Project.Name} · {test.Mode}")</small>
                        @if (!test.IsAvailable) { <small class="d-block">Not in the latest discovery</small> }
                        @if (test.RunState is not null && test.RunState != "Runnable") { <small class="d-block">@test.RunState</small> }
                    </th>
                    <td class="test-description">
                        <p>@test.Description</p>
                        <form method="post" asp-page="/Index" asp-page-handler="Run" hx-post="@Url.Page("/Index", "Run")"
                              hx-target="#test-list" hx-swap="innerHTML" hx-sync="#test-list:drop" hx-disabled-elt="#test-list form button:not([disabled]), .refresh-button:not([disabled])" hx-request='{"timeout":15000}'>
                            <input type="hidden" name="testId" value="@test.Id" />
                            <button class="btn btn-primary btn-sm" type="submit" disabled="@(!canRun)" aria-label="Queue @test.Name (@test.Mode)">@(testBusy ? "Already queued / running" : "Queue test")</button>
                            <small>@(testBusy ? (latest?.State == "Queued" ? $"Position {latest.QueuePosition} in this project’s queue." : "This test is starting or running.") : !Model.CanRun ? "Run from the server machine for now." : Model.ConnectedProjects?.Contains(test.ProjectId ?? "") != true ? "Connect Unity to run." : !test.IsAvailable ? "Refresh discovery in Unity." : "")</small>
                        </form>
                        @if (latest is not null)
                        {
                            <details class="run-results">
                                <summary>Latest attempt: @latest.State · @latest.DurationSeconds.ToString("F3")s</summary>
                                <p>Requested @latest.RequestedAt.ToString("u") · Outcome: @(string.IsNullOrEmpty(latest.Outcome) ? "Awaiting Unity" : latest.Outcome)</p>
                                @if (latest.StartedAt is not null) { <p>Started @latest.StartedAt.Value.ToString("u")</p> }
                                @if (latest.FinishedAt is not null) { <p>Finished @latest.FinishedAt.Value.ToString("u")</p> }
                                @if (!string.IsNullOrEmpty(latest.Message)) { <h3>Result / error</h3><pre>@latest.Message</pre> }
                                @if (!string.IsNullOrEmpty(latest.StackTrace)) { <h3>Stack trace</h3><pre>@latest.StackTrace</pre> }
                                @if (!string.IsNullOrEmpty(latest.Output)) { <h3>Test output</h3><pre>@latest.Output</pre> }
                                <small>Run ID: @latest.Id</small>
                                <p><a asp-page="/Runs" asp-route-id="@latest.Id">View full logs</a></p>
                                @if (test.Runs.Count > 1)
                                {
                                    <h3>Previous attempts</h3>
                                    @foreach (var attempt in test.Runs.OrderByDescending(x => x.RequestedAt).Skip(1))
                                    {
                                        <details><summary>@attempt.RequestedAt.ToString("u") · @attempt.State · @attempt.DurationSeconds.ToString("F3")s</summary>
                                            <p>Outcome: @attempt.Outcome · Run ID: @attempt.Id</p>
                                            <pre>@attempt.Message</pre><pre>@attempt.StackTrace</pre><pre>@attempt.Output</pre>
                                            <p><a asp-page="/Runs" asp-route-id="@attempt.Id">View full logs</a></p>
                                        </details>
                                    }
                                }
                            </details>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
